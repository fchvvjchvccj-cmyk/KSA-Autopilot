<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences" Condition="!Exists('$(GamePath)/KSA.dll')">
    <Error Text="请通过 -p:GamePath 指定兼容版本的游戏目录。" />
  </Target>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Reference Include="KSA"><HintPath>$(GamePath)/KSA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ImGui"><HintPath>$(GamePath)/Brutal.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Glfw"><HintPath>$(GamePath)/Brutal.Glfw.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Numerics"><HintPath>$(GamePath)/Brutal.Core.Numerics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Strings"><HintPath>$(GamePath)/Brutal.Core.Strings.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepuUtilities"><HintPath>$(GamePath)/BepuUtilities.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
